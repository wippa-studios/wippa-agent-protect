# Wippa environment variables (copy to .env and fill in; never commit real values)

# Comma-separated list of domains allowed through the egress proxy.
# Defaults (when unset): OpenAI, Anthropic, Groq, DeepSeek, Mistral, Cohere,
# Together, Fireworks, GitHub. Set to an empty value for full network isolation.
WIPPA_ALLOWED_DOMAINS=

# Optional CLI injectable API key (pass with --api-key instead, or set here)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=